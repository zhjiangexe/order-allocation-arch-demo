getSeed))\n  (def! c (. shape :corners))\n  (def! h 76)\n  (def! yc (+ t 16))\n  (def! buttons (. shape :getPropertyValue \"Buttons\"))\n  (. canvas :strokeRoundRect (- l g) (- t g) (+ r g) (+ b g) c seed)\n  (if buttons\n    (do \n      (. canvas :ellipse (+ l 14) (- yc 5) (+ l 24) (+ yc 5) (+ seed 2))\n      (. canvas :ellipse (+ l 32) (- yc 5) (+ l 42) (+ yc 5) (+ seed 3))\n      (. canvas :ellipse (+ l 50) (- yc 5) (+ l 60) (+ yc 5) )+ seed 4)))))"}],"corners":[12,12,12,12],"textEditable":false}],"name":"Archone 08｜DLT 訊息","enable":false,"pageOrigin":[21.8194580078125,76.0467529296875]}]}