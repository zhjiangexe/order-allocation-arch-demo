flowchart TB
  subgraph SOURCE[Source document]
    EVENT([OrderPlacedIntegrationEvent])
    ADAPTER[OrderStockMovementAdapter<br/>canonicalize source + lines]
  end

  subgraph OPERATION[Durable Inventory intent]
    REGISTER[StockOperationRegistrar]
    OP[CONFIRMED StockOperation<br/>source unit + policy + queue + route]
    MOVES[CONFIRMED StockMoves<br/>source line + SKU + quantity + route]
  end

  subgraph PROCESS[Transient assignment process]
    SELECT[StockOperationAssignmentCandidateFinder]
    BLOCK{Earlier shared-SKU<br/>confirmed operation?}
    PLAN[MovementAssignmentPlanner<br/>pure FEFO + SHIP_COMPLETE]
    READY{Exact complete proposal?}
    ASSIGN[StockAllocationCommitter.commit<br/>lock + revalidate + apply]
  end

  subgraph DETAIL[Reservation / execution detail]
    LINES[StockMoveLines<br/>move + quant + quantity]
    QUANTS[StockQuants<br/>reserved counters]
    ASSIGNED[Operation + Moves = ASSIGNED]
    OUTBOX[Assignment Outbox<br/>operation + moves + batches]
  end

  subgraph WMS[Warehouse execution]
    SHIPMENT[Shipment by stockOperationId]
    WORK[Wave / Pick / Pack / Stage]
  end

  EVENT --> ADAPTER --> REGISTER --> OP --> MOVES --> SELECT --> BLOCK
  BLOCK -- yes --> MOVES
  BLOCK -- no --> PLAN --> READY
  READY -- no --> MOVES
  READY -- yes --> ASSIGN --> QUANTS --> LINES --> ASSIGNED --> OUTBOX --> SHIPMENT --> WORK
