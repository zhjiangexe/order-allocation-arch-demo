flowchart TB
  subgraph MODEL[Canonical Inventory model]
    SOURCE[Source document identity]
    PICKING[StockOperation<br/>operation group / policy]
    MOVE[StockMove<br/>SKU / quantity / route]
    LINE[StockMoveLine<br/>quant / quantity detail]
    QUANT[StockQuant<br/>on-hand / reserved]
    SOURCE --> PICKING --> MOVE --> LINE
    LINE <--> QUANT
  end

  subgraph INBOUND[Inbound]
    RECEIPT[ConfirmStockReceiptUsecase]
    INREG[Register inbound operation + move]
    INCOMPLETE[Complete + retain move line]
    RECEIVE[Quant onHand += quantity]
    AVAILABLE[Availability Outbox]
    RECEIPT --> INREG --> INCOMPLETE --> RECEIVE --> AVAILABLE
  end

  subgraph OUTBOUND[Outbound assignment]
    ORDER([OrderPlaced])
    REG[Register confirmed operation + moves]
    SELECT[Select + pure plan]
    ASSIGN[StockAllocationCommitter]
    RESERVE[Move lines + Quant reserved += quantity]
    HANDOFF[Assignment Outbox]
    ORDER --> REG --> SELECT --> ASSIGN --> RESERVE --> HANDOFF
  end

  AVAILABLE -. retry confirmed queues .-> SELECT

  subgraph WMS[WMS-owned execution]
    SHIPMENT[Shipment by stockOperationId]
    WORK[Wave → Pick → Pack → Stage]
    HANDED[ShipmentHandedOver]
    SHIPMENT --> WORK --> HANDED
  end
  HANDOFF --> SHIPMENT

  subgraph TERMINAL[Inventory terminal / reversible operations]
    RELEASE[Release<br/>delete lines; reserved -= quantity<br/>moves return CONFIRMED]
    CANCEL[Cancel<br/>WMS reversible decision if assigned<br/>moves become CANCELLED]
    COMPLETE[Complete<br/>retain lines; onHand/reserved -= quantity<br/>moves become DONE]
    AUDIT[StockOperationLifecycleIntegrationEvent<br/>before-image batches]
    RELEASE --> AUDIT
    CANCEL --> AUDIT
    COMPLETE --> AUDIT
  end

  RESERVE --> RELEASE
  RESERVE --> CANCEL
  HANDED --> COMPLETE
