flowchart TB
  START([StockOperationBacklogReconciliationScheduler tick])
  USECASE[StockOperationBacklogReconciler<br/>bounded work/time budget]
  FIND[Find queue keys with available stock]
  KEY[AssignmentQueueKey<br/>owner + source location + SKU]
  NEXT{Budget and deadline remain?}
  ATTEMPT[StockOperationAssignmentCoordinator<br/>one independent transaction]
  SELECT[StockOperationAssignmentCandidateFinder<br/>earliest confirmed shared-SKU operation]
  PLAN[MovementAssignmentPlanner<br/>pure SHIP_COMPLETE proposal]
  READY{Complete and unblocked?}
  ASSIGN[StockAllocationCommitter<br/>at most one operation]
  AGAIN[Keep key for next fair round]
  STOP[Stop this key until later trigger]
  DONE([Run complete])

  START --> USECASE --> FIND --> KEY --> NEXT
  NEXT -- no --> DONE
  NEXT -- yes --> ATTEMPT --> SELECT --> PLAN --> READY
  READY -- yes --> ASSIGN --> AGAIN --> NEXT
  READY -- no --> STOP --> NEXT
