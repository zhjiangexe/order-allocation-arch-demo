flowchart TB
    START([Reconciliation scheduler tick])
    USECASE["<b>ReconcileWaitingDemandUsecase.execute</b><br/>只管理工作 queue，不包住整輪 transaction"]
    FIND["<b>findAllocatablePendingScopes(today, scopeLimit)</b><br/>找出有 PENDING demand 且目前有可配庫存的 scope keys"]
    SCOPE["<b>WaitingAllocationScope</b><br/>ownerId + facilityId + locationId + skuCode<br/><i>只是查詢 key，不含 demand List 或筆數</i>"]
    INIT["pendingScopes = new ArrayDeque&lt;&gt;(scopes)<br/>remainingAttempts = scopeLimit"]
    HAS_WORK{"還有 scope<br/>且 remainingAttempts &gt; 0？"}
    DONE(["本次 reconciliation 結束"])
    POP["scope = pendingScopes.removeFirst()<br/>remainingAttempts--"]
    TX["<b>TransactionalAllocationAttempt.attempt</b><br/>開啟該 scope 的獨立 transaction<br/>本次最多 commit 一筆 demand"]
    PIPELINE["<b>PendingDemandAllocator</b><br/>依 scope 重新查 PENDING candidate<br/>→ <b>AllocationFifoSelector</b><br/>→ <b>AllocationDemandPlanner</b><br/>→ 可行才呼叫 <b>AllocationCommitter</b>"]
    SUCCESS{"本次有成功<br/>commit 一筆 demand？"}
    REQUEUE["pendingScopes.addLast(scope)<br/><b>放回隊尾</b><br/>該 scope 可能還有 successor<br/>但先讓其他 scope 獲得機會"]
    DROP["<b>不放回 queue</b><br/>FIFO blocked / 缺貨 / 衝突 / 失敗<br/>避免同一 tick 無效重試"]

    START --> USECASE --> FIND --> SCOPE --> INIT --> HAS_WORK
    HAS_WORK -- "否" --> DONE
    HAS_WORK -- "是" --> POP --> TX --> PIPELINE --> SUCCESS
    SUCCESS -- "是" --> REQUEUE --> HAS_WORK
    SUCCESS -- "否" --> DROP --> HAS_WORK

    classDef trigger fill:#e8f1ff,stroke:#2563eb,color:#172554,stroke-width:1.5px;
    classDef usecase fill:#ede9fe,stroke:#7c3aed,color:#2e1065,stroke-width:2px;
    classDef transaction fill:#ecfeff,stroke:#0891b2,color:#164e63,stroke-width:2px;
    classDef component fill:#f8fafc,stroke:#64748b,color:#0f172a,stroke-width:1.5px;
    classDef queue fill:#fefce8,stroke:#ca8a04,color:#713f12,stroke-width:1.5px;
    classDef success fill:#ecfdf5,stroke:#059669,color:#064e3b,stroke-width:1.5px;
    classDef stop fill:#fef2f2,stroke:#dc2626,color:#7f1d1d,stroke-width:1.5px;

    class START trigger;
    class USECASE usecase;
    class TX transaction;
    class FIND,PIPELINE component;
    class SCOPE,INIT,POP queue;
    class REQUEUE success;
    class DROP stop;
