@startuml
title OrderFulfillmentWorkflow.execute 流程圖

skinparam defaultFontName "Heiti TC"
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #475569
skinparam ActivityBorderColor #475569
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FFF7D6
skinparam ActivityDiamondBorderColor #B7791F
skinparam ActivityStartColor #2563EB
skinparam ActivityEndColor #2563EB

start
:execute(OrderFulfillmentWorkflowInput);
:取得 processId;

partition "1. Shipment 建立前：配貨" {
  :AllocationCheckpoint.waiting();
  :enterPhase(ALLOCATION);
  :RequestAllocation Activity; <<#E8F1FF>>
  :Workflow.await(isCommitted()\n或 cancellation.isRequested()); <<#FFF7D6>>

  if (cancellation.isRequested()？) then (是)
    :enterPhase(CANCELLATION); <<#FDECEC>>
    :cancelOrderInOrdering(); <<#FDECEC>>
    :finishCancellation(); <<#FDECEC>>
    stop
  else (否)
    :requireCommittedSnapshot();
  endif
}

partition "2. WMS 建立 Shipment" {
  :enterPhase(WMS_SHIPMENT_CREATION);
  :CreateShipment Activity; <<#E8F1FF>>
  :CreateShipmentUsecase
  以 allocationId 冪等建立／讀回; <<#E2F0D9>>
  :ShipmentCheckpoint.recordCreated(shipmentId);
}

partition "3. Shipment 已建立：等待 handover，可被取消中斷" {
  :enterPhase(SHIPMENT_HANDOVER);
  :Workflow.await(shipment.hasTerminal()\n或 cancellation.isRequested()); <<#FFF7D6>>
  note right
    等待期間由 WMS 可設定延遲的模擬 runtime 獨立執行：
    Wave -> Release -> Pick -> Pack -> Stage -> Handover
  end note

  if (cancellation.isRequested() 且
  尚無 correlated terminal？) then (是)
    :requestShipmentCancellation(); <<#FDECEC>>
    note right
      詳細展開於 cancellation-flow 圖：
      Activity 只確認 command 已提交；
      終態由 canonical event Signal 決定。
    end note
    :Workflow.await(shipment.hasTerminal()); <<#FFF7D6>>
  else (否)
    :既有 terminal 直接決定路線；
    handover 先到時不再提交取消 command; <<#FFF7D6>>
  endif

  :terminal = shipment.requireTerminal();

  if (terminal = CANCELLED？) then (是)
    :以 ShipmentCancelled.cancelledAt
    cancelOrderInOrdering(); <<#FDECEC>>
    :finishCancellation(); <<#FDECEC>>
    stop
  else (否：HANDED_OVER)
    :正常履約路線勝出；
    若曾受理取消，保留 request 作為事實; <<#FFF7D6>>
  endif
}

partition "4. 出庫完成" {
  :enterPhase(OUTBOUND_COMPLETION);
  :CompleteOutboundMovements Activity; <<#E8F1FF>>
  :依 MoveLine 正式扣 reserved + on-hand；
  Move／Operation = DONE; <<#E2F0D9>>
}

partition "5. 訂單完成" {
  :enterPhase(ORDER_COMPLETION);
  :RecordOrderFulfillment Activity; <<#E8F1FF>>
  :核對 orderId + shipmentId + fulfilledAt；
  fulfilledAt 沿用 handoverAt; <<#E2F0D9>>
  :finish(FULFILLMENT_COMPLETED);
}

stop

legend bottom
  |<#E8F1FF>| Activity 呼叫 |
  |<#E2F0D9>| Usecase／Domain 狀態變更 |
  |<#DCEEFF>| 現階段 WMS 可設定延遲的模擬 runtime |
  |<#FFF7D6>| Durable wait／判斷 |
  |<#FDECEC>| 取消分支 |
endlegend
@enduml
