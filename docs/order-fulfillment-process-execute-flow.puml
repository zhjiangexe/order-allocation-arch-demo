@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam activityBackgroundColor #EAF2FA
skinparam activityBorderColor #365A7C
skinparam activityDiamondBackgroundColor #FFF3D6
skinparam activityDiamondBorderColor #94732C
skinparam noteBackgroundColor #F4F6F8
skinparam noteBorderColor #A4AFBA
skinparam ArrowColor #43576B
skinparam dpi 140

title OrderFulfillmentWorkflowImpl.execute\nStage overview

start
partition "Stage 1 - Allocation" {
  :ALLOCATION\nrequestAllocation Activity;
  :Wait for committed assignment\nor cancellation request;
  if (Cancellation requested?) then (yes)
    :cancelOrderActivityAndFinish()\nUse Workflow.currentTimeMillis();
    stop
  else (no)
  endif
}
partition "Stage 2 - Warehouse execution" {
  :WAREHOUSE_EXECUTION\nreleaseToWarehouse Activity;\nRecord Shipment identity;
  :Stage 2.1\nWait for cancellation request or carrier handover;
  if (Cancellation requested\nand no confirmed handover?) then (yes)
    :Stage 2.2\nrequestShipmentCancellationActivity();
    note right
      Enters CANCELLING and calls the WMS Activity.
      REJECTED: return to WAREHOUSE_EXECUTION.
      An acknowledgement is not cancellation completion.
    end note
  else (no)
  endif
  :Stage 2.3\nWait for carrier handover or Shipment cancellation;
}
partition "Stage 3 - Finalize the Order" {
  if (Shipment outcome?) then (handed over)
    :INVENTORY_FINALIZATION\ncompleteOutboundMovements Activity;
    :ORDER_COMPLETION\nrecordOrderFulfillment Activity;
    :markFinished(FULFILLMENT_COMPLETED);
    stop
  else (cancelled)
    :cancelOrderActivityAndFinish()\nUse Shipment cancellation time;
    stop
  endif
}
legend bottom
  cancelOrderActivityAndFinish(): CANCELLING -> cancelOrder Activity
  -> record cancellation -> markFinished(ORDER_CANCELLED).
  Ordering REJECTED fails the Workflow; it does not mark cancellation complete.

  Updates record cancellation intent. Signals report WMS outcomes.
  Only this Workflow requests WMS cancellation; its Signal follows that Activity invocation.
  Signals can arrive before Activity replies. An already-satisfied wait returns immediately.
  Inventory release after Order cancellation continues asynchronously.
  Retry policy and contradictory-fact failure paths are omitted for clarity.
endlegend
@enduml
