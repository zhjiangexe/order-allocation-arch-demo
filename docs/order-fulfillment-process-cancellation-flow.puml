@startuml
title Order fulfillment 取消流程：共用 REST 入口與兩種 orchestration mode

skinparam defaultFontName "PingFang TC"
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #475569
skinparam ActivityBorderColor #475569
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FFF7D6
skinparam ActivityDiamondBorderColor #B7791F
skinparam ActivityStartColor #2563EB
skinparam ActivityEndColor #2563EB
skinparam NoteBorderColor #B7791F
skinparam NoteBackgroundColor #FFF7D6

start

partition "A. 共用 HTTP 入口" {
  :POST /orders/{orderId}/cancellation-requests; <<#E8F1FF>>
  :OrderCancellationRest
  建立 immutable request
  requestId + requestedAt + reason; <<#E8F1FF>>
  :依 archone.fulfillment.orchestration-mode
  注入唯一 CancellationRequestCoordinator; <<#FFF7D6>>
}

if (Order 已 FULFILLED？) then (是)
  :回 409 REJECTED
  必須改走 return flow; <<#FFF0F0>>
  stop
endif

if (orchestration mode？) then (events)
  partition "B1. Events mode：持久化 process manager" {
    :EventDrivenCancellationRequestCoordinator
    向 Ordering 評估是否可受理; <<#E8F1FF>>
    :AcceptCancellationRequestUsecase
    保存 WAITING_WMS 與 WMS 取消請求 outbox; <<#E2F0D9>>
    :回 202 ACCEPTED；流程仍在進行; <<#E8F1FF>>
    :WmsCancellationRequestedIntegrationEvent
    → WMS 查詢並處理 Shipment; <<#EDE9FE>>
    if (Shipment 可取消？) then (是)
      :WMS 完成停止作業／recovery
      Shipment = CANCELLED; <<#FDECEC>>
      :ShipmentCancelledIntegrationEvent; <<#EDE9FE>>
    else (無 Shipment／拒絕／多張)
      :WmsCancellationRequestResolvedIntegrationEvent; <<#EDE9FE>>
    endif
    :HandleWmsCancellationOutcomeUsecase
    保存 WMS 結果與下一個流程狀態; <<#E8F1FF>>
    if (WMS 允許取消 Order？) then (是)
      :同交易發布 OrderingCancellationRequestedIntegrationEvent
      流程進入 WAITING_ORDERING; <<#EDE9FE>>
      :Ordering 取消 Order 並發布
      OrderCancelledIntegrationEvent 與
      OrderingCancellationRequestResolvedIntegrationEvent; <<#FDECEC>>
      :RecordOrderingCancellationOutcomeUsecase
      流程進入 COMPLETED 或 CONFLICT; <<#E8F1FF>>
    else (否)
      :流程進入 REJECTED 或 CONFLICT; <<#FFF0F0>>
      stop
    endif
  }
else (temporal)
  partition "B2. Temporal mode：Update 既有 Workflow" {
    :TemporalCancellationRequestCoordinator; <<#E8F1FF>>
    :requestCancellation(Update); <<#E8F1FF>>

    if (correlated handover
    已先記錄？) then (是)
      :回 409 REJECTED；不保存新 request
      正常履約路線已勝出; <<#FFF0F0>>
      :既有 Workflow 繼續完成
      outbound movements 與 Order; <<#E2F0D9>>
      stop
    else (否)
      :保存第一筆 immutable CancellationRequestInput; <<#FDECEC>>
      :回 ACK
      ACCEPTED／ALREADY_REQUESTED／ALREADY_CANCELLED; <<#E8F1FF>>
    endif

    note right
      ACCEPTED 只表示請求已 durable 進入 Workflow，
      不表示 Shipment、Order 或 Inventory 已完成取消。
    end note

    if (Shipment 尚未建立？) then (是)
      :CancelOrder Activity → CancelOrderUsecase
      Order = CANCELLED；發布
      OrderCancelledIntegrationEvent; <<#FDECEC>>
      :Workflow = FINISHED / ORDER_CANCELLED; <<#FDECEC>>
    else (已建立)
      :requestShipmentCancellation Activity
      僅確認 command transaction 已提交; <<#FDECEC>>
      :等待 ShipmentCancelled 或
      ShipmentHandedOver 具體終態 Signal; <<#FFF7D6>>
      if (WMS terminal fact？) then (ShipmentCancelled)
        :使用事件的實際 cancelledAt
        執行 CancelOrder Activity → CancelOrderUsecase
        Order = CANCELLED；發布
        OrderCancelledIntegrationEvent; <<#FDECEC>>
        :Workflow = FINISHED / ORDER_CANCELLED; <<#FDECEC>>
      else (ShipmentHandedOver)
        :handover 在 command／recovery 競爭中勝出；
        保留已受理 request 作為事實; <<#FFF7D6>>
        :依既有 handover fact 完成出庫與 Order; <<#E2F0D9>>
        stop
      endif
    endif
  }
endif

partition "C. 兩種模式共用的 Inventory cleanup" {
  :Debezium → Kafka
  OrderCancelledIntegrationEvent; <<#EDE9FE>>
  :AllocationOrderCancellationEventConsumer
  Inbox transaction; <<#E8F1FF>>
  :CancelMovementsUsecase
  取消 PENDING／ALLOCATED demand、Move、Picking
  並釋放 reservation; <<#E2F0D9>>
}

stop

legend bottom
  |<#E8F1FF>| HTTP／consumer／Temporal boundary |
  |<#E2F0D9>| Usecase／Domain／DB 狀態變更 |
  |<#EDE9FE>| Integration Event／Outbox／Kafka |
  |<#FDECEC>| 已接受的取消與補償 |
  |<#FFF7D6>| Durable wait／mode policy |
  |<#FFF0F0>| 業務拒絕，不改寫既有履約狀態 |
endlegend

@enduml
