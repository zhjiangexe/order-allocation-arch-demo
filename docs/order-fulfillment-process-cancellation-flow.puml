@startuml
title OrderFulfillmentWorkflow 取消協調活動圖（目前實作）

skinparam defaultFontName "PingFang TC"
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #475569
skinparam ActivityBorderColor #475569
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FFF7D6
skinparam ActivityDiamondBorderColor #B7791F
skinparam ActivityStartColor #2563EB
skinparam ActivityEndColor #2563EB
skinparam NoteBorderColor #B7791F
skinparam NoteBackgroundColor #FFF7D6

start

partition "A. Update 受理" {
  :validateCancellationRequest();
  if (request 為 null 或屬於其他 Order？) then (是)
    :IllegalArgumentException
    拒絕本次 Update；不改變 Workflow state; <<#FFF7D6>>
    stop
  endif

  :requestCancellation();
  if (Order 取消已提交？) then (是)
    :ACK ALREADY_CANCELLED;
    stop
  elseif (已觀察到 handover 或先前已拒絕？) then (是)
    :ACK REJECTED;
    stop
  elseif (已有取消請求？) then (是)
    :ACK ALREADY_REQUESTED;
    stop
  else (首次請求)
    :保存 immutable CancellationRequest
    requestId + orderId + requestedAt + reason; <<#FDECEC>>
    :OrderFulfillmentWorkflowCancellationState = REQUESTED; <<#FDECEC>>
    :ACK ACCEPTED;
  endif
}

note right
  ACCEPTED 只表示請求已 durable 進入 Workflow，
  不表示 Shipment 或 Order 已取消。

  目前尚未實作對外 REST／人工取消 entrypoint。
end note

partition "B. execute 在 checkpoint 處理" {
  if (Shipment 尚未建立？) then (是)
    :enterPhase(CANCELLATION); <<#FDECEC>>
    :cancelOrderInOrdering(); <<#FDECEC>>
    :CancelOrder Activity
    使用同一個 requestId; <<#FDECEC>>
    :Order + OrderCancelled Outbox
    同一 transaction; <<#FDECEC>>
    :OrderFulfillmentWorkflowCancellationState = ORDER_CANCELLED; <<#FDECEC>>
    :finishCancellation(ORDER_CANCELLED); <<#FDECEC>>
    stop
  else (已建立)
    :cancelShipmentInWms(); <<#FDECEC>>
    :CancelShipment Activity
    帶 requestId/orderId/shipmentId; <<#FDECEC>>
  endif
}

partition "C. WMS 同步決策" {
  :CancelShipmentUsecase 核對 requestId
  並儲存 cancellation outcome; <<#E2F0D9>>
  if (WMS domain outcome？) then (CANCELLED /\nALREADY_CANCELLED)
    :Activity 回傳 CANCELLED; <<#FDECEC>>
    if (同 Shipment 的 handover 已觀察？) then (是)
      :non-retryable ApplicationFailure
      WMS_SHIPMENT_FACT_CONFLICT; <<#FFF0F0>>
      stop
    endif
  else (PUTBACK_REQUIRED /\nREJECTED_AFTER_HANDOVER)
    :Activity 目前統一回傳 REJECTED; <<#FFF7D6>>
    :OrderFulfillmentWorkflowCancellationState = REJECTED; <<#FFF7D6>>
    :不取消 Order; <<#FFF7D6>>
    :等待同一 Shipment handover
    後繼續履約主線; <<#FFF7D6>>
    stop
  endif
}

partition "D. WMS 已安全取消，再取消 Order" {
  :cancelOrderInOrdering(); <<#FDECEC>>
  :CancelOrder Activity 核對同一
  requestId/orderId/requestedAt/reason; <<#FDECEC>>
  if (Ordering 回傳其他 Order 或 REJECTED？) then (是)
    :non-retryable ApplicationFailure
    ORDER_CANCELLATION_REJECTED; <<#FFF0F0>>
    stop
  endif
  :OrderFulfillmentWorkflowCancellationState = ORDER_CANCELLED; <<#FDECEC>>
  :finishCancellation(ORDER_CANCELLED); <<#FDECEC>>
}

stop

legend bottom
  |<#FDECEC>| 取消 command／狀態推進 |
  |<#E2F0D9>| Usecase／Domain／DB 已實作 |
  |<#FFF7D6>| 業務決策／目前限制 |
  |<#FFF0F0>| 明確失敗 Workflow Execution 的 contract conflict |
endlegend
@enduml
