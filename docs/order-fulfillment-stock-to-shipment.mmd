flowchart TB
  subgraph O[Ordering]
    PLACE[PlaceOrderUsecase]
    OP[OrderPlacedIntegrationEvent]
    PROJECT[RecordOrderAllocationUsecase]
    FINISH[RecordOrderFulfillmentUsecase<br/>Order = FULFILLED]
  end

  subgraph DRIVER[One orchestration driver]
    MODE{events or temporal}
    EVENTS[Event consumers]
    TEMPORAL[OrderFulfillmentWorkflow]
  end

  subgraph I[Inventory]
    REGISTER[Register CONFIRMED operation + moves]
    DECIDE{FIFO clear and<br/>all SKUs sufficient?}
    WAIT[Same moves remain CONFIRMED]
    WAKE[Availability event or backlog scheduler]
    ASSIGN[Assign existing moves atomically]
    FACT[Order assignment v3<br/>stockOperationId + moves + batches]
    COMPLETE[Complete operation<br/>Moves = DONE / Quant consumed]
    AUDIT[Lifecycle audit Outbox]
    OC[Outbound completion v3]
  end

  subgraph W[WMS]
    CREATE[Create Shipment by stockOperationId]
    OPS[Wave → Pick → Pack → Stage]
    HAND[Hand over to carrier]
    SH[ShipmentHandedOver v3]
  end

  PLACE --> OP --> MODE
  MODE --> EVENTS
  MODE --> TEMPORAL
  EVENTS --> REGISTER
  TEMPORAL --> REGISTER
  REGISTER --> DECIDE
  DECIDE -- no --> WAIT
  WAIT -. later .-> WAKE --> DECIDE
  DECIDE -- yes --> ASSIGN --> FACT
  FACT --> PROJECT
  FACT --> CREATE
  CREATE --> OPS --> HAND --> SH
  SH --> COMPLETE --> AUDIT
  COMPLETE --> OC --> FINISH
