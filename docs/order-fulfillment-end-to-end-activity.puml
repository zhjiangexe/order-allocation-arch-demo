@startuml
title Order Fulfillment 端到端活動圖（目前已實作範圍）

skinparam defaultFontName "PingFang TC"
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #475569
skinparam ActivityBorderColor #475569
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FFF7D6
skinparam ActivityDiamondBorderColor #B7791F
skinparam ActivityStartColor #2563EB
skinparam ActivityEndColor #2563EB
skinparam NoteBorderColor #B7791F
skinparam NoteBackgroundColor #FFF7D6

start

partition "Ordering：收單" {
  :PlaceOrderUsecase 接受訂單; <<#E2F0D9>>
  :同一 transaction 寫入
  Order(PENDING) + OrderPlacedIntegrationEvent Outbox; <<#E2F0D9>>
}

partition "可靠訊息與 orchestration driver" {
  :Debezium -> Kafka
  OrderPlacedIntegrationEvent; <<#EDE9FE>>
  note right
    Producer 永遠只發布一份 canonical event；
    mode 只決定哪一組 consumer 擁有副作用。
  end note
  if (orchestration mode？) then (temporal)
    :以 order-fulfillment/{orderId}
    啟動唯一 Workflow; <<#E8F1FF>>
    :RequestOrderAllocation Activity; <<#E8F1FF>>
  else (events)
    :AllocationOrderPlacedEventConsumer; <<#E8F1FF>>
  endif
}

partition "Inventory：Demand / Reservation" {
  :AllocateOrderUsecase; <<#E2F0D9>>
  :Acceptance 建立或重播
  immutable AllocationDemand; <<#E2F0D9>>

  while (整張 demand 的所有 SKU\n都有足夠 supply？) is (否)
    :Demand 保持 PENDING
    不建立部分 reservation; <<#FFF7D6>>
    :入庫／可用量增加
    喚醒 PendingDemandBacklogAllocationUsecase; <<#E8F1FF>>
    :依 FIFO 重選 demand；
    Planner 重新比較 supply/demand; <<#E2F0D9>>
  endwhile (是)

  :Planner 依 canonical line + FEFO
  建立 allocation plan; <<#E2F0D9>>
  :Committer 以 optimistic lock 驗證並提交
  StockQuant reservation + Move + Picking; <<#E2F0D9>>
  :Demand = ALLOCATED；
  OrderAllocationCommittedIntegrationEvent Outbox; <<#E2F0D9>>
}

partition "可靠訊息與 WMS handoff" {
  :Kafka OrderAllocationCommittedIntegrationEvent; <<#EDE9FE>>
  if (orchestration mode？) then (temporal)
    :allocationCommitted Signal
    喚醒既有 Workflow; <<#E8F1FF>>

    if (Shipment 建立前收到 cancellation Update？) then (是)
      :CancelOrder Activity
      帶穩定 requestId/reason; <<#FDECEC>>
      :Order cancellation + Outbox
      同一 transaction; <<#FDECEC>>
      :Workflow = ORDER_CANCELLED
      不等待 Inventory cleanup; <<#FDECEC>>
      :Inventory 消費 OrderCancelled
      釋放 reservation／取消 Move; <<#FDECEC>>
      stop
    endif

    :CreateShipment Activity; <<#E8F1FF>>
  else (events)
    :WmsFulfillmentHandoffEventConsumer; <<#E8F1FF>>
  endif
}

partition "WMS：Shipment 與倉內作業" {
  :CreateShipmentUsecase
  以 allocationId 冪等建立 Shipment; <<#E2F0D9>>
  :Shipment = CREATED; <<#E2F0D9>>

  if (Shipment 存在後收到 cancellation？) then (是)
    if (orchestration mode？) then (temporal)
      :requestShipmentCancellation Activity
      提交 immutable command; <<#FDECEC>>
      :Activity 完成只代表 command transaction 已提交；
      等待兩種 canonical terminal Signal; <<#FFF7D6>>

      if (WMS terminal fact？) then (ShipmentCancelled)
        :Shipment = CANCELLED；
        cancellationState = COMPLETED; <<#FDECEC>>
        :ShipmentCancelledIntegrationEvent Outbox
        -> shipmentCancelled Signal; <<#EDE9FE>>
        :CancelOrder Activity
        -> OrderCancelled Outbox; <<#FDECEC>>
        :Workflow = ORDER_CANCELLED; <<#FDECEC>>
        :Inventory 消費 OrderCancelled
        釋放 reservation／取消 Move; <<#FDECEC>>
        stop
      else (ShipmentHandedOver)
        :carrier handover 在 recovery 前勝出；
        保留已受理 request 並繼續正常履約; <<#FFF7D6>>
        :handover fact 已成立; <<#E2F0D9>>
      endif
    else (events)
      :EventDrivenFulfillmentCancellationCoordinator
      -> CancelShipmentUsecase; <<#FDECEC>>

      if (CancelShipmentStatus？) then (ACCEPTED /
      ALREADY_ACCEPTED)
        if (實體作業已開始？) then (是)
          :Shipment = CANCELLING；
          WMS recovery backlog 完成停止／回庫; <<#FFF7D6>>
        endif
        :Shipment = CANCELLED；
        cancellationState = COMPLETED; <<#FDECEC>>
        :ShipmentCancelledIntegrationEvent Outbox
        帶 requestedAt 與實際 cancelledAt; <<#EDE9FE>>
        :OrderingShipmentCancellationEventConsumer
        -> CancelOrderUsecase; <<#E8F1FF>>
        :OrderCancelled Outbox
        -> Inventory 釋放 reservation; <<#FDECEC>>
        stop
      else (REJECTED)
        :carrier handover 已先提交；
        正常履約已勝出，取消改走 Return flow; <<#FFF0F0>>
        :handover fact 已成立; <<#E2F0D9>>
      endif
    endif
  endif

  if (handover fact 已成立？) then (是)
    :沿用既有 ShipmentHandedOverIntegrationEvent; <<#E2F0D9>>
  else (否)
    :DB 時間到期（createdAt + configured delay）; <<#FFF7D6>>
    :SimulatedWarehouseOperationsUsecase
    Wave -> Release -> Pick -> Pack -> Stage; <<#DCEEFF>>
    :handOverToCarrier
    Shipment = HANDED_OVER_TO_CARRIER; <<#E2F0D9>>
    :ShipmentHandedOverIntegrationEvent Outbox; <<#E2F0D9>>
  endif
}

note right
  目前沒有串真實 WMS／設備入口。
  processing delay 可依環境設定；預設為 10 秒，
  E2E 會用 0 秒或 30 秒建立不同 checkpoint；
  未來只替換這一段，handover 後的線路不變。

  Events mode 的取消由 REST controller 呼叫
  EventDrivenFulfillmentCancellationCoordinator；
  Temporal mode 則把同一請求送進既有 Workflow Update。

  已開始作業的 cancellation 會進入 CANCELLING，
  simulation 由獨立 recovery backlog 完成；
  真實 WMS 未來可替換此 driver，不改跨 Context event。
end note

partition "可靠訊息與 completion driver" {
  :Debezium -> Kafka
  ShipmentHandedOverIntegrationEvent; <<#EDE9FE>>
  if (orchestration mode？) then (temporal)
    :shipmentHandedOverToCarrier Signal; <<#E8F1FF>>
    :CompleteOutboundMovements Activity; <<#E8F1FF>>
  else (events)
    :ShipmentHandoverEventConsumer; <<#E8F1FF>>
  endif
}

partition "Inventory：正式出庫扣帳" {
  :CompleteOutboundMovementsUsecase; <<#E2F0D9>>
  :依既有 MoveLine 扣 reserved + on-hand；
  Move／Picking = DONE; <<#E2F0D9>>
  :OutboundMovementsCompletedIntegrationEvent Outbox; <<#E2F0D9>>
}

partition "Ordering：履約終態" {
  if (orchestration mode？) then (temporal)
    :RecordOrderFulfillment Activity; <<#E8F1FF>>
  else (events)
    :Kafka completion event
    -> OrderingFulfillmentCompletionEventConsumer; <<#EDE9FE>>
  endif

  :RecordOrderFulfillmentUsecase
  核對 orderId + shipmentId + fulfilledAt; <<#E2F0D9>>
  :Order = FULFILLED
  fulfilledAt = handoverAt; <<#E2F0D9>>
}

stop

legend bottom
  |<#E2F0D9>| Usecase／Domain／DB 已實作 |
  |<#E8F1FF>| Entry point／Temporal Activity／Signal |
  |<#EDE9FE>| Outbox／Debezium／Kafka |
  |<#DCEEFF>| 暫行 WMS 可設定延遲的模擬 runtime |
  |<#FFF7D6>| Durable wait／供需或決策 checkpoint |
  |<#FDECEC>| Cancellation 安全分支 |
endlegend

@enduml
