@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam activityBackgroundColor #EAF2FA
skinparam activityBorderColor #365A7C
skinparam activityDiamondBackgroundColor #FFF3D6
skinparam activityDiamondBorderColor #94732C
skinparam noteBackgroundColor #F4F6F8
skinparam noteBorderColor #A4AFBA
skinparam ArrowColor #43576B
skinparam dpi 140

title 訂單履約\n簡化活動圖

start
partition "階段 1 - 庫存分配" {
  :ALLOCATION\nrequestAllocation Activity;
  :等待分配承諾\n或取消請求;
  if (收到取消請求？) then (是)
    :cancelOrderActivityAndFinish()\n使用 Workflow.currentTimeMillis();
    stop
  else (否)
  endif
}
partition "階段 2 - 倉內執行" {
  :WAREHOUSE_EXECUTION\nreleaseToWarehouse Activity;
  :記錄出貨作業識別\n並關聯提前到達的 Signal;
  :等待取消請求或承運商交接;
  if (收到取消請求\n且尚未確認交接？) then (是)
    :requestShipmentCancellationActivity();
    note right
      進入 CANCELLING 並呼叫 WMS Activity。
      REJECTED：返回 WAREHOUSE_EXECUTION。
      收到確認不代表取消已完成。
    end note
  else (否)
  endif
  :等待承運商交接或出貨作業取消;
}
partition "階段 3 - 判定出貨作業結果" {
  if (已確認出貨作業取消？) then (是)
    :cancelOrderActivityAndFinish()\n使用出貨作業取消時間;
    stop
  else (否：已確認交接)
  endif
}
partition "階段 4 - 完成出庫移動" {
  :INVENTORY_FINALIZATION\ncompleteOutboundMovements Activity;
}
partition "階段 5 - 完成訂單" {
  :ORDER_COMPLETION\nrecordOrderFulfillment Activity;
  :markFinished(FULFILLMENT_COMPLETED);
  stop
}
legend bottom
  cancelOrderActivityAndFinish()：CANCELLING -> cancelOrder Activity
  -> 記錄取消 -> markFinished(ORDER_CANCELLED)。
  Ordering REJECTED 會使 Workflow 失敗，不會標記取消完成。

  Update 會記錄取消意圖。Signal 會回報 WMS 結果。
  只有此 Workflow 會請求 WMS 取消；對應 Signal 會在該 Activity 呼叫後送達。
  Signal 可能早於 Activity 回應抵達；等待條件若已滿足，會立即繼續。
  訂單取消後，庫存釋放仍會非同步繼續。
  為保持圖表簡潔，省略重試政策與矛盾事實的失敗路徑。
endlegend
@enduml
