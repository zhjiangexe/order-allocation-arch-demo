ARCHONE_COMPOSE_PROJECT=archone-dev
ARCHONE_IMAGE=archone-monolith
ARCHONE_IMAGE_TAG=dev
ARCHONE_HTTP_BIND_ADDRESS=0.0.0.0
ARCHONE_HTTP_PORT=28290
ARCHONE_MANAGEMENT_BIND_ADDRESS=127.0.0.1
ARCHONE_MANAGEMENT_PORT=28295
ARCHONE_POSTGRES_PORT=28291
ARCHONE_KAFKA_PORT=28292
ARCHONE_CONNECT_PORT=28293

SPRING_PROFILES_ACTIVE=dev
ORDER_PROMISING_PORT=8080
ORDER_PROMISING_MANAGEMENT_PORT=8081
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
ORDER_PROMISING_DB_NAME=order_promising
ORDER_PROMISING_DB_URL=jdbc:postgresql://postgres:5432/order_promising
ORDER_PROMISING_DB_USERNAME=order_promising
ORDER_PROMISING_DB_PASSWORD=order_promising
ORDER_PROMISING_KAFKA_BOOTSTRAP_SERVERS=kafka:19092
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
