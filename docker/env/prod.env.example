ARCHONE_COMPOSE_PROJECT=archone-prod
ARCHONE_IMAGE=registry.example.com/flowzati/archone-monolith
ARCHONE_IMAGE_TAG=replace-with-immutable-release-tag
ARCHONE_HTTP_BIND_ADDRESS=0.0.0.0
ARCHONE_HTTP_PORT=8080
ARCHONE_MANAGEMENT_BIND_ADDRESS=127.0.0.1
ARCHONE_MANAGEMENT_PORT=8081
ARCHONE_CPU_LIMIT=2.0
ARCHONE_MEMORY_LIMIT=2G

SPRING_PROFILES_ACTIVE=prod
ORDER_PROMISING_PORT=8080
ORDER_PROMISING_MANAGEMENT_PORT=8081
ORDER_PROMISING_DB_URL=jdbc:postgresql://prod-postgres.example.com:5432/order_promising
ORDER_PROMISING_DB_USERNAME=replace-me
ORDER_PROMISING_DB_PASSWORD=replace-me
ORDER_PROMISING_KAFKA_BOOTSTRAP_SERVERS=prod-kafka.example.com:9092
ORDER_PROMISING_FULFILLMENT_ORCHESTRATION_MODE=events
ORDER_PROMISING_WMS_SIMULATION_ENABLED=true
ORDER_PROMISING_WMS_SIMULATION_PROCESSING_DELAY=10s
# temporal 模式才需要；必須是平台 private network 上的 Temporal frontend。
ORDER_PROMISING_TEMPORAL_TARGET=prod-temporal.example.com:7233
ORDER_PROMISING_TEMPORAL_NAMESPACE=default
ORDER_PROMISING_KAFKA_MISSING_TOPICS_FATAL=true
ORDER_PROMISING_KAFKA_ALLOW_AUTO_CREATE_TOPICS=false
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=65.0 -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError
